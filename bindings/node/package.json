{
  "name": "@memvid/node",
  "version": "0.1.0",
  "description": "Node.js bindings for memvid — a crash-safe, single-file AI memory",
  "main": "index.js",
  "types": "index.d.ts",
  "private": true,
  "license": "Apache-2.0",
  "napi": {
    "name": "memvid-node",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "devDependencies": {
    "@napi-rs/cli": "^2"
  }
}
