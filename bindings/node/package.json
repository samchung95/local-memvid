{
  "name": "@memvid/node",
  "version": "0.1.0",
  "description": "Node.js bindings for memvid — a crash-safe, single-file AI memory",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "Apache-2.0",
  "napi": {
    "name": "memvid-node",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm",
    "postinstall": "node scripts/postinstall.js",
    "version": "napi version",
    "test:smoke": "node __test__/smoke.mjs"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "scripts/"
  ],
  "optionalDependencies": {
    "@memvid/node-linux-x64-gnu": "0.1.0",
    "@memvid/node-darwin-x64": "0.1.0",
    "@memvid/node-darwin-arm64": "0.1.0",
    "@memvid/node-win32-x64-msvc": "0.1.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2"
  }
}
